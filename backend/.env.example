# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API Key auth (recommended over the account Auth Token — see
# console.twilio.com/us1/account/keys-credentials/api-keys):
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here
# Create a Verify Service at console.twilio.com/us1/develop/verify/services
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Twilio number you send outbound deal texts from (E.164 format, e.g. +18885551234)
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database (neon.tech, free tier) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- Admin dashboard auth ---
# Password you'll type to log into admin.html. Pick your own.
ADMIN_PASSWORD=choose_a_strong_password
# Random string used to sign admin session cookies — not memorized/typed
# anywhere, just needs to be long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# --- Server ---
PORT=3000
